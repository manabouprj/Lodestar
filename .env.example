# Copy to .env and fill in. Never commit .env.
# ---- platform ---------------------------------------------------------------
LODESTAR_API_KEYS=ciso:change-me-32-chars-minimum-aaaaaaa,analyst:change-me-32-chars-minimum-bbbbbb,exec:change-me-32-chars-minimum-cccccccc
LODESTAR_WEBHOOK_SECRET=change-me-long-random-string
LODESTAR_SESSION_SECRET=change-me-48-random-characters-for-signed-sessions
LODESTAR_METRICS_TOKEN=change-me-prometheus-bearer-token
LODESTAR_LOG=INFO
LODESTAR_LOG_FORMAT=json                 # one JSON object per line for your SIEM; remove for plain text
# Tip: `python -m lodestar init` generates all of the above and adds the variables your connectors need.
# ---- Single sign-on (security.oidc) - Entra ID, Okta, Google, Keycloak, Ping ----
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
# ---- SIEM-first integration (sentinel / splunk adapters and threat_hunt) ----
SENTINEL_WORKSPACE_ID=
SPLUNK_URL=
SPLUNK_TOKEN=
# ---- Microsoft (Defender XDR / Sentinel / Entra) - app registration, read-only permissions
AZ_TENANT_ID=
AZ_CLIENT_ID=
AZ_CLIENT_SECRET=
# ---- Tenable Vulnerability Management -------------------------------------
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=
# ---- ITSM (ServiceNow / Jira) ----------------------------------------------
ITSM_BASE_URL=
ITSM_USERNAME=
ITSM_API_TOKEN=
# ---- Optional LLM narrative (llm.provider: anthropic) -----------------------
ANTHROPIC_API_KEY=
# ---- ChatOps (chatops.* in config/lodestar.yaml) -----------------------------
LODESTAR_PUBLIC_URL=https://lodestar.your-org.example
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=
TEAMS_WORKFLOW_URL=
TEAMS_OUTGOING_WEBHOOK_TOKEN=
# ---- External reports & intelligence (threat_intel / bug_bounty connectors) ---
H1_API_IDENTIFIER=
H1_API_TOKEN=
H1_PROGRAM=
LODESTAR_H1_WEBHOOK_SECRET=
CERT_TAXII_API_ROOT=
CERT_TAXII_COLLECTION=
CERT_TAXII_TOKEN=
ISAC_MISP_URL=
ISAC_MISP_KEY=
ADVISORY_IMAP_HOST=
ADVISORY_IMAP_USER=
ADVISORY_IMAP_PASSWORD=
