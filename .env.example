# Copy to .env and fill in. Never commit .env.
# ---- platform ---------------------------------------------------------------
LODESTAR_API_KEYS=ciso:change-me-32-chars-minimum-aaaaaaa,analyst:change-me-32-chars-minimum-bbbbbb,exec:change-me-32-chars-minimum-cccccccc
LODESTAR_WEBHOOK_SECRET=change-me-long-random-string
LODESTAR_LOG=INFO
# ---- Microsoft (Defender XDR / Sentinel / Entra) - app registration, read-only permissions
AZ_TENANT_ID=
AZ_CLIENT_ID=
AZ_CLIENT_SECRET=
# ---- Tenable Vulnerability Management -------------------------------------
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=
# ---- ITSM (ServiceNow / Jira) ----------------------------------------------
ITSM_BASE_URL=
ITSM_USERNAME=
ITSM_API_TOKEN=
# ---- Optional LLM narrative (llm.provider: anthropic) -----------------------
ANTHROPIC_API_KEY=
